{
    "name": "sylius/mollie-plugin",
    "type": "sylius-plugin",
    "description": "Mollie payment plugin for Sylius applications.",
    "license": "MIT",
    "require": {
        "mollie/mollie-api-php": "^2.73",
        "payum/payum-bundle": "^2.7",
        "php": "^8.2",
        "sylius/sylius": "^2.2.9",
        "sylius/telemetry": "^1.0",
        "willdurand/js-translation-bundle": "^8.0"
    },
    "require-dev": {
        "behat/behat": "^3.22 || 4.0.0-alpha1",
        "behat/mink": "^1.10 || ^1.13",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink-browserkit-driver": "^1.6.3",
        "friends-of-behat/mink-debug-extension": "^2.2",
        "friends-of-behat/mink-extension": "^2.7 || ^3.0@alpha",
        "friends-of-behat/page-object-extension": "^0.4",
        "friends-of-behat/symfony-extension": "^2.6.2",
        "friends-of-behat/variadic-extension": "^1.6",
        "lchrusciel/api-test-case": "^6.0",
        "matthiasnoback/symfony-dependency-injection-test": "^6.2",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "polishsymfonycommunity/symfony-mocker-container": "^1.0",
        "slevomat/coding-standard": "~8.22.1",
        "sylius-labs/behat-chrome-extension": "^1.5",
        "sylius-labs/coding-standard": "^4.0",
        "sylius/test-application": "^2.2.0@alpha || ^2.3.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8.0",
        "symfony/flex": "^2.0",
        "symfony/intl": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.2",
        "winzou/state-machine": "^0.4",
        "winzou/state-machine-bundle": "^0.6"
    },
    "suggest": {
        "sylius/refund-plugin": "To allow refunding payments in the Mollie payment method."
    },
    "scripts": {
        "analyse": [
            "@composer validate --strict",
            "vendor/bin/phpstan analyse",
            "vendor/bin/ecs check src/"
        ],
        "fix": [
            "vendor/bin/ecs check src/ --fix"
        ]
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Sylius\\MolliePlugin\\": "src/",
            "Tests\\Sylius\\MolliePlugin\\": [
                "tests/",
                "tests/TestApplication/src/"
            ]
        }
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": false,
            "symfony/thanks": false
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "require": "^7.4",
            "allow-contrib": false,
            "docker": false
        },
        "public-dir": "vendor/sylius/test-application/public"
    }
}
