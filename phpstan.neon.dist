parameters:
    reportUnmatchedIgnoredErrors: false

    level: 6
    paths:
        - src

    excludePaths:
        # Makes PHPStan crash
        - 'src/DependencyInjection/Configuration.php'
        - 'src/Refund/Validator/*.php'
        - 'src/EventListener/PaymentPartialEventListener.php'

    ignoreErrors:
        - identifier: missingType.generics

        - '#Construct empty\(\) is not allowed. Use more strict comparison.#'
        - '#Call to function method_exists\(\) with Doctrine\\DBAL\\Query\\QueryBuilder and .+ will always evaluate to true.#'
        - '#Negated boolean expression is always true.#'

        - '#Property .* is never read, only written.#'
        - '#Method .*get.*Translation\(\) should return Sylius\\.*Resource\\Model\\TranslationInterface but returns Sylius\\.*Resource\\Model\\TranslationInterface.#'

        - '#.*Sylius\\RefundPlugin\\.*#'
