{% import '@SyliusAdmin/shared/helper/money.html.twig' as money %}


{% set mollie_subscription = hookable_metadata.context.resource %}
{% set orderItem = mollie_subscription.orderItem %}

{% if orderItem is not null %}
    <div class="row mb-2 border-bottom pb-2">
        <div class="col-md-4 fw-bold">{{ 'sylius.ui.item'|trans }} {{ 'sylius.ui.id'|trans }}</div>
        <div class="col-md-8">{{ orderItem.id }}</div>
    </div>
    <div class="row mb-2 border-bottom pb-2">
        <div class="col-md-4 fw-bold">{{ 'sylius.ui.items'|trans }} {{ 'sylius.ui.quantity'|trans }}</div>
        <div class="col-md-8">{{ orderItem.quantity }}</div>
    </div>
    <div class="row mb-2 border-bottom pb-2">
        <div class="col-md-4 fw-bold">{{ 'sylius.ui.unit_price'|trans }}</div>
        <div class="col-md-8">{{ money.format(orderItem.unitPrice, orderItem.order.currencyCode) }}</div>
    </div>
{% endif %}
