{% set mollie_subscription = hookable_metadata.context.resource %}
{% set orderItem = mollie_subscription.orderItem %}
{% set order = orderItem.order %}

{% if orderItem is not null %}
    <div class="row mb-2 border-bottom pb-2">
        <div class="col-md-4 fw-bold">{{ 'sylius.ui.order'|trans }} {{ 'sylius.ui.number'|trans }}</div>
        <div class="col-md-8"><a class="fw-medium" href="{{ path('sylius_admin_order_show', {'id' : order.id })|raw }}" data-bs-toggle="tooltip" data-bs-title="{{ 'sylius.ui.show_order_details'|trans }}">#{{ order.number }}</a></div>
    </div>
{% endif %}
