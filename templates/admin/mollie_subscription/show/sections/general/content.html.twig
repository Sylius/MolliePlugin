{% set mollie_subscription = hookable_metadata.context.resource %}
{% set customer = mollie_subscription.customer %}
{% set orderItem = mollie_subscription.orderItem %}
{% set config = mollie_subscription.subscriptionConfiguration %}

<div class="container">
    <h2 class="mb-4">{{ 'sylius_mollie.ui.subscription_details'|trans }}</h2>

    <div class="row mb-2">
        <div class="col-md-4 fw-bold">{{ 'sylius.ui.id'|trans }}</div>
        <div class="col-md-8">{{ mollie_subscription.id }}</div>
    </div>

    <div class="row mb-2">
        <div class="col-md-4 fw-bold">{{ 'sylius.ui.state'|trans }}</div>
        <div class="col-md-8">{{ mollie_subscription.state }}</div>
    </div>

    <div class="row mb-2">
        <div class="col-md-4 fw-bold">{{ 'sylius.ui.processing_state'|trans }}</div>
        <div class="col-md-8">{{ mollie_subscription.processingState }}</div>
    </div>

    <div class="row mb-2">
        <div class="col-md-4 fw-bold">{{ 'sylius.ui.payment_state'|trans }}</div>
        <div class="col-md-8">{{ mollie_subscription.paymentState }}</div>
    </div>

    <div class="row mb-2">
        <div class="col-md-4 fw-bold">{{ 'sylius.ui.recent_failed_payments_count'|trans }}</div>
        <div class="col-md-8">{{ mollie_subscription.recentFailedPaymentsCount }}</div>
    </div>

    <div class="row mb-2">
        <div class="col-md-4 fw-bold">{{ 'sylius.ui.created_at'|trans }}</div>
        <div class="col-md-8">{{ mollie_subscription.createdAt|date('Y-m-d H:i:s') }}</div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4 fw-bold">{{ 'sylius.ui.started_at'|trans }}</div>
        <div class="col-md-8">{{ mollie_subscription.startedAt|date('Y-m-d H:i:s') }}</div>
    </div>

    {% if customer is not null %}
        <h4 class="mt-4">{{ 'sylius.ui.customer'|trans }}</h4>
        <div class="row mb-2">
            <div class="col-md-4 fw-bold">{{ 'sylius.ui.customer_id'|trans }}</div>
            <div class="col-md-8">{{ customer.id }}</div>
        </div>
        <div class="row mb-2">
            <div class="col-md-4 fw-bold">{{ 'sylius.ui.gender'|trans }}</div>
            <div class="col-md-8">{{ customer.gender }}</div>
        </div>
        <div class="row mb-2">
            <div class="col-md-4 fw-bold">{{ 'sylius.ui.subscribed_to_newsletter'|trans }}</div>
            <div class="col-md-8">
                {{ customer.subscribedToNewsletter ? ('sylius.ui.yes'|trans) : ('sylius.ui.no'|trans) }}
            </div>
        </div>
    {% endif %}

     OrderItem
    {% if orderItem is not null %}
        <h4 class="mt-4">{{ 'sylius.ui.order_item'|trans }}</h4>
        <div class="row mb-2">
            <div class="col-md-4 fw-bold">{{ 'sylius.ui.id'|trans }}</div>
            <div class="col-md-8">{{ orderItem.id }}</div>
        </div>
        <div class="row mb-2">
            <div class="col-md-4 fw-bold">{{ 'sylius.ui.quantity'|trans }}</div>
            <div class="col-md-8">{{ orderItem.quantity }}</div>
        </div>
        <div class="row mb-2">
            <div class="col-md-4 fw-bold">{{ 'sylius.ui.unit_price'|trans }}</div>
            <div class="col-md-8">{{ orderItem.unitPrice }}</div>
        </div>
    {% endif %}

    {% if config is not null %}
        <h4 class="mt-4">{{ 'sylius_mollie.ui.subscription_configuration'|trans }}</h4>
        <div class="row mb-2">
            <div class="col-md-4 fw-bold">ID</div>
            <div class="col-md-8">{{ config.id }}</div>
        </div>
        <div class="row mb-2">
            <div class="col-md-4 fw-bold">{{ 'sylius_mollie.ui.number_of_repetitions'|trans }}</div>
            <div class="col-md-8">{{ config.numberOfRepetitions }}</div>
        </div>
    {% endif %}
</div>
