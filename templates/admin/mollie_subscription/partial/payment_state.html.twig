{% set state_to_colors_map = {
    pending: 'warning',
    fail: 'danger',
    ok: 'success'
    } %}
    {% set state_to_icons_map = {
    pending: 'bi-arrow-repeat',
    fail: 'bi-x-circle',
    ok: 'bi-check-circle'
    } %}

    <span class="badge bg-{{ state_to_colors_map[data]|default('secondary') }} d-inline-flex align-items-center {% if attached is defined and attached == true %} w-100 rounded-0 {% endif %}">
    <i class="bi {{ state_to_icons_map[data]|default('bi-exclamation-circle') }} me-1"></i>
    {{ ('sylius_mollie.ui.subscription.payment_state.' ~ data) | trans }}
</span>
