    <div class="field">
        <div class="fields">
            <div class="twelve wide field">
                {# TODO: this condition is potentially unneeded #}
                {% if
                    inner_payment_method.methodId == mealvouchersId or
                    inner_payment_method.methodId == klarnaOne or
                    inner_payment_method.methodId == klarnaPayLater or
                    inner_payment_method.methodId == klarnaSliceIt or
                    inner_payment_method.methodId == billie or
                    inner_payment_method.methodId == alma or
                    inner_payment_method.methodId == riverty or
                    inner_payment_method.methodId == in3 %}
                    {{ form_row(method_form.paymentType, {'attr': {'disabled': 'disabled', 'class': 'js-onboardingWizard-PaymentMethod'}}) }}
                    {{ form_help(method_form.paymentType) }}
                {% else %}
                    {{ form_row(method_form.paymentType, { 'attr': { 'class': 'js-onboardingWizard-PaymentMethod' } }) }}
                    {{ form_help(method_form.paymentType) }}
                {% endif %}
            </div>
            <div class="four wide field">
                {{ form_row(method_form.orderExpirationDays) }}
            </div>
        </div>
    </div>
    <div class="field">
        {% if
            inner_payment_method.methodId == ideal or
            inner_payment_method.methodId == bancontact %}
            {{ form_row(method_form.qrCodeEnabled) }}
        {% endif %}
    </div>
    <div class="field">
        <div class="js-onboardingWizard-order-number">
            {{ form_widget(method_form.paymentDescription, { 'attr': { 'class': 'js-onboardingWizard-paymentDescription' } }) }}
            <div id="payment_description_{{ name }}">
                {{ method_form.paymentDescription.vars.help|trans|raw|nl2br }}
            </div>
        </div>
    </div>
    <h4 class="ui horizontal divider header">
        {{ 'sylius_mollie.ui.payment_fee'|trans }}
    </h4>
    {{ form_row(method_form.paymentSurchargeFee, { 'attr': { 'class': 'js-onboardingWizard-paymentFee' } }) }}
    <h4 class="ui horizontal divider header">
        {{ 'sylius_mollie.ui.min_max'|trans }}
    </h4>
    <h5>{{ 'sylius_mollie.form.amount_limit_help'|trans }}</h5>
    {{ form_row(method_form.amountLimits, { 'attr': { 'class': 'js-onboardingWizard-minMax fields' } }) }}
